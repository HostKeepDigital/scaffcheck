{
  "name": "ComplianceDocument",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string"
    },
    "operative_id": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "document_type": {
      "type": "string",
      "enum": [
        "CISRS Card",
        "Public Liability Insurance",
        "Employers Liability Insurance",
        "RAMS"
      ]
    },
    "file_url": {
      "type": "string"
    },
    "file_uri": {
      "type": "string"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "uploaded_at": {
      "type": "string",
      "format": "date-time"
    },
    "verdict_outcome": {
      "type": "string",
      "enum": [
        "clean",
        "warn"
      ]
    },
    "verdict_message": {
      "type": "string",
      "maxLength": 500
    },
    "override_confirmed": {
      "type": "boolean",
      "default": false
    },
    "issue_date_source": {
      "type": "string",
      "enum": [
        "ai",
        "manual"
      ]
    },
    "expiry_date_source": {
      "type": "string",
      "enum": [
        "ai",
        "manual"
      ]
    }
  },
  "required": [
    "account_id",
    "operative_id",
    "document_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.account_id": "{{user.data.account_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.account_id": "{{user.data.account_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.account_id": "{{user.data.account_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.account_id": "{{user.data.account_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}