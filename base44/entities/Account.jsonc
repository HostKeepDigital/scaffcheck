{
  "name": "Account",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "trial_active",
        "active",
        "lapsed"
      ],
      "default": "trial_active"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "has_used_trial": {
      "type": "boolean",
      "default": false
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "crew",
        "contractor",
        "firm"
      ]
    },
    "billing": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ],
      "default": "monthly"
    },
    "pending_plan": {
      "type": "string",
      "enum": [
        "crew",
        "contractor",
        "firm"
      ]
    },
    "pending_billing": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ]
    },
    "cancel_at_period_end": {
      "type": "boolean",
      "default": false
    },
    "cancel_at": {
      "type": "string",
      "format": "date-time"
    },
    "operative_count": {
      "type": "integer",
      "default": 0
    }
  },
  "required": [
    "company_name",
    "owner_user_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}